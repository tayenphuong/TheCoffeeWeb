@model TheCoffee.Models.CancelOrder

@if (Model != null)
{
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <strong>Thông tin hủy đơn</strong>
        </div>
        <div class="card-body">
            <p><strong>Lý do hủy:</strong> @Model.Reason</p>
            <p><strong>Người hủy:</strong> @Model.User.FullName</p>
            <p><strong>Ngày hủy:</strong> @Model.CancelDate.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Không có thông tin hủy đơn.</div>
}

