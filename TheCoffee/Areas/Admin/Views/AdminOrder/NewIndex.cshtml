@model TheCoffee.Models.ViewModel.OrderListVM
@{
    ViewBag.Title = "Đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Quản lý đơn hàng</h2>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success text-center">
        @TempData["Success"]
    </div>
}
<p>
    @Html.ActionLink("Tạo đơn", "Create", null, new { @class = "btn btn-primary btn-sm" })
</p>
<ul class="nav nav-tabs" id="orderTab" role="tablist">
    <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#moi">Chờ xác nhận</a></li>
    <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#xuly">Đã xác nhận</a></li>
    <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#dagiao">Đang giao</a></li>
    <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#dahuy">Đã hủy</a></li>
    <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#dahoanthanh">Đã hoàn thành</a></li>
</ul>

<div class="tab-content mt-3">
    <div class="tab-pane fade show active" id="moi">
        @Html.Partial("_OrderTablePartial", Model.Moi)
    </div>
    <div class="tab-pane fade" id="xuly">
        @Html.Partial("_OrderTablePartial", Model.DangXuLy)
    </div>
    <div class="tab-pane fade" id="dagiao">
        @Html.Partial("_OrderTablePartial", Model.DaGiao)
    </div>
    <div class="tab-pane fade" id="dahuy">
        @Html.Partial("_OrderTablePartial", Model.DaHuy)
    </div>
    <div class="tab-pane fade" id="dahoanthanh">
        @Html.Partial("_OrderTablePartial", Model.DaHoanThanh)
    </div>
</div>
